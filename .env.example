# --- Modelo ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=pon-aqui-una-frase-larga-y-secreta
WHATSAPP_APP_SECRET=
# Versión de la Graph API. Comprueba en Meta cuál sigue vigente.
GRAPH_VERSION=v23.0

# --- Telegram (solo para pruebas: npm run telegram) ---
# Créalo hablando con @BotFather (/newbot). Con Telegram, ALLOWED_PHONES y OWNER_PHONE llevan tu chat id,
# que el bot te muestra en la terminal la primera vez que le escribes.
TELEGRAM_TOKEN=

# --- Acceso ---
# Números autorizados a hablar con el bot (solo dígitos, con prefijo de país, separados por comas).
ALLOWED_PHONES=
# Tu WhatsApp, para recibir avisos de incidencias y aprobaciones.
OWNER_PHONE=
# Plantilla de utilidad aprobada en Meta para avisarte fuera de la ventana de 24 h (1 variable en el cuerpo).
OWNER_TEMPLATE=
OWNER_TEMPLATE_LANG=es

# Plantillas de utilidad (una por idioma, 1 variable en el cuerpo) para escribir al cliente
# fuera de la ventana de 24 h: recordatorios de check-in/check-out y aviso de reserva confirmada.
REMINDER_TEMPLATE_EN=
REMINDER_TEMPLATE_ES=
REMINDER_TEMPLATE_AR=

# --- Servidor y datos ---
PORT=3000
DB_PATH=data/vassist.db
