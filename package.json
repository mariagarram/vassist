{
  "name": "vassist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VASSIST: asistente personal de viajes por WhatsApp (EN/AR)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "cli": "tsx --env-file-if-exists=.env src/channels/cli.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "telegram": "tsx --env-file-if-exists=.env src/telegram.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
